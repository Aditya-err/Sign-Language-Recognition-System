# ==============================================================================
# Sign Language Recognition V2 — Git Ignore Policy
# ==============================================================================

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
conda-env/

# IDE and Editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.directory
.DS_Store
Thumbs.db

# Large Datasets & Archives
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.json
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.npy
*.npz
*.parquet
*.h5

# Model Weights and Checkpoints (Track metadata JSON, ignore binary weights)
models/*.keras
models/*.h5
models/*.onnx
models/*.tflite
models/*.pb
models/variables/
*.ckpt*
!models/.gitkeep
!models/*.json

# Logging, Monitoring & Checkpoints
logs/
Logs/
*.tfevents.*
wandb/
.mlflow/

# Camera captures, screen dumps & videos
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
!reports/figures/.gitkeep
!reports/figures/*.png
!reports/figures/*.jpg
!docs/dataset_samples/*.jpg
!docs/dataset_samples/*.png
!src/ui/web/static/signs/*.jpg
!src/ui/web/static/signs/*.png

# Testing and Profiling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sensitive files
secrets.yaml
.env.local
*.pem
*.key
